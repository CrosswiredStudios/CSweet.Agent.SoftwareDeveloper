<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CSweetWorkManagementContractsRepositoryRoot Condition="'$(CSweetWorkManagementContractsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.WorkManagement.Contracts</CSweetWorkManagementContractsRepositoryRoot>
    <UseLocalCSweetWorkManagementContracts Condition="'$(UseLocalCSweetWorkManagementContracts)' == '' and Exists('$(CSweetWorkManagementContractsRepositoryRoot)\src\CSweet.WorkManagement.Contracts\CSweet.WorkManagement.Contracts.csproj')">true</UseLocalCSweetWorkManagementContracts>
    <UseLocalCSweetWorkManagementContracts Condition="'$(UseLocalCSweetWorkManagementContracts)' == ''">false</UseLocalCSweetWorkManagementContracts>
    <CSweetAgentSdkRepositoryRoot Condition="'$(CSweetAgentSdkRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Agent.Sdk</CSweetAgentSdkRepositoryRoot>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == '' and Exists('$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj')">true</UseLocalCSweetAgentSdk>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == ''">false</UseLocalCSweetAgentSdk>
  </PropertyGroup>
  <PropertyGroup>
    <CSweetWebPreviewsRepositoryRoot Condition="'$(CSweetWebPreviewsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Plugins.WebPreviews</CSweetWebPreviewsRepositoryRoot>
    <UseLocalWebPreviews Condition="'$(UseLocalWebPreviews)' == '' and Exists('$(CSweetWebPreviewsRepositoryRoot)/src/CSweet.Plugins.WebPreviews.Client/CSweet.Plugins.WebPreviews.Client.csproj')">true</UseLocalWebPreviews>
    <UseLocalWebPreviews Condition="'$(UseLocalWebPreviews)' == ''">false</UseLocalWebPreviews>
  </PropertyGroup>
</Project>
