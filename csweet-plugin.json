{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "individual-contributor.v1",
    "declaredRoleKeys": [
      "software-developer"
    ]
  },
  "id": "com.csweet.software-developer",
  "name": "Daniel Kim",
  "version": "1.2.1",
  "publisher": {
    "id": "com.csweet",
    "name": "C-Sweet"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agents.SoftwareDeveloper/CSweet.Agents.SoftwareDeveloper.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1,
    "environmentProfile": "software-development-polyglot-v1",
    "workspaceAccess": "ReadWrite"
  },
  "protocol": {
    "minimumVersion": "2.0",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "work.execution.run.v1",
      "description": "Execute one pinned board workflow stage and return a structured outcome without mutating the card transition.",
      "inputSchema": {
        "type": "object",
        "required": [
          "stageExecutionId",
          "attemptId",
          "boardId",
          "itemId",
          "stageKey",
          "instructions",
          "item",
          "input"
        ],
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "stageExecutionId",
          "attemptId",
          "disposition",
          "outcomeCode",
          "summary",
          "output",
          "evidence",
          "diagnostics"
        ],
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 3600,
      "idempotency": "work-item",
      "riskClass": "elevated"
    },
    {
      "name": "software-development.implement.v1",
      "description": "Implement an approved software change in a granted repository and return a reviewable, evidence-backed report.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "objective",
          "requirements",
          "acceptanceCriteria"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "baseBranch": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "constraints": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workId",
          "report",
          "completedAt"
        ],
        "properties": {
          "workId": {
            "type": "string",
            "format": "uuid"
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "executionTimeoutSeconds": 900,
      "idempotency": "work-item",
      "riskClass": "elevated"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Software Developer configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "agentVersion",
          "schemaVersion",
          "fields",
          "settings"
        ],
        "properties": {
          "agentId": {
            "type": "string"
          },
          "agentVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "label",
                "type",
                "required"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "placeholder": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "options": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                },
                "minimum": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maximum": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "step": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "dependsOnFieldKey": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": {
                "type": "string"
              },
              "llmModel": {
                "type": "string"
              },
              "maxContextWindowTokens": {
                "type": "number"
              },
              "maxOutputTokens": {
                "type": "number"
              },
              "customInstructions": {
                "type": "string"
              }
            }
          }
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Software Developer configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "settings"
        ],
        "properties": {
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": {
                "type": "string"
              },
              "llmModel": {
                "type": "string"
              },
              "maxContextWindowTokens": {
                "type": "number",
                "minimum": 16000,
                "maximum": 2000000
              },
              "maxOutputTokens": {
                "type": "number",
                "minimum": 1000,
                "maximum": 200000
              },
              "customInstructions": {
                "type": "string"
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "succeeded",
          "settings"
        ],
        "properties": {
          "succeeded": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "llmProviderId": {
                "type": "string"
              },
              "llmModel": {
                "type": "string"
              },
              "maxContextWindowTokens": {
                "type": "number"
              },
              "maxOutputTokens": {
                "type": "number"
              },
              "customInstructions": {
                "type": "string"
              }
            }
          }
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [
    {
      "name": "work.calendar.read.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.create.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.update.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.cancel.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.calendar.schedule.v1",
      "scope": "organization",
      "purpose": "Operate the business calendar within event ownership and reporting authority."
    },
    {
      "name": "work.personal-todo.read.v1",
      "scope": "organization",
      "purpose": "Read resource-scoped personal queues"
    },
    {
      "name": "work.personal-todo.add.v1",
      "scope": "organization",
      "purpose": "Add self or direct-report personal work"
    },
    {
      "name": "work.personal-todo.reorder.v1",
      "scope": "organization",
      "purpose": "Reorder directly managed personal work"
    },
    {
      "name": "work.personal-todo.requeue.v1",
      "scope": "organization",
      "purpose": "Requeue blocked personal work"
    },
    {
      "name": "work.personal-todo.claim.v1",
      "scope": "organization",
      "purpose": "SDK-managed atomic personal work claims"
    },
    {
      "name": "work.personal-todo.complete.v1",
      "scope": "organization",
      "purpose": "SDK-managed personal work completion"
    },
    {
      "name": "work.personal-todo.block.v1",
      "scope": "organization",
      "purpose": "SDK-managed durable personal work blocking"
    },
    {
      "name": "work.personal-todo.release.v1",
      "scope": "organization",
      "purpose": "SDK-managed personal work release"
    },
    {
      "name": "platform.team-roster.read.v1",
      "scope": "team",
      "purpose": "Read only this developer employee's approved teammates and team-specific roles"
    },
    {
      "name": "platform.llm.chat-stream.v1",
      "scope": "organization",
      "purpose": "Run the Microsoft Agent Framework harness with the installation's approved coding model"
    },
    {
      "name": "work.item.read",
      "scope": "work-item",
      "purpose": "Re-read the authoritative assigned development ticket"
    },
    {
      "name": "work.item.comment",
      "scope": "work-item",
      "purpose": "Attach bounded validation evidence or a sanitized blocker to the assigned ticket"
    },
    {
      "name": "work.item.comments.read",
      "scope": "work-item",
      "purpose": "Read Architect guidance linked to the exact assigned ticket"
    },
    {
      "name": "work.orchestration.read",
      "scope": "work-item",
      "purpose": "Read the exact assigned stage execution state"
    },
    {
      "name": "work.orchestration.retry",
      "scope": "work-item",
      "purpose": "Request a governed retry after consuming linked Architect guidance",
      "modelVisible": false
    },
    {
      "name": "communication.coordination.start-work.v1",
      "scope": "team",
      "purpose": "Request bounded technical support from the team Architect",
      "modelVisible": false
    },
    {
      "name": "communication.coordination.respond.v1",
      "scope": "team",
      "purpose": "Finalize work-item support after guidance and governed retry",
      "modelVisible": false
    },
    {
      "name": "communication.coordination.read.v1",
      "scope": "team",
      "purpose": "Read only support sessions in which this Developer participates"
    },
    {
      "name": "git.workspace.prepare.v2",
      "scope": "work-item",
      "purpose": "Clone or resume the ticket's installation-granted repository workspace"
    },
    {
      "name": "git.workspace.refresh.v2",
      "reason": "Refreshes the assigned credential-free workspace against its Core-authorized base.",
      "required": true
    },
    {
      "name": "git.workspace.inspect.v2",
      "scope": "work-item",
      "purpose": "Collect sanitized changed-file and commit metadata"
    },
    {
      "name": "git.workspace.publish.v2",
      "scope": "work-item",
      "purpose": "Push only the deterministic ticket branch and create a configured pull request"
    },
    {
      "name": "git.workspace.cleanup.v2",
      "scope": "work-item",
      "purpose": "Remove successful workspaces and retain failed workspaces for recovery"
    },
    {
      "reason": "Optional private product build, demo and testing under owner-approved scoped grants.",
      "name": "platform.build.request.v2"
    },
    {
      "reason": "Optional private product build, demo and testing under owner-approved scoped grants.",
      "name": "platform.build.read.v2"
    },
    {
      "name": "compute.provision.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "compute.read.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "compute.list.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "compute.execute.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "compute.stop.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "compute.destroy.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "network.inbound.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "network.publish-port.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "work.personal-todo.defer.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "communication.chat.read.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    },
    {
      "name": "communication.message.send.v1",
      "scope": "organization",
      "purpose": "Create and report explicitly requested ephemeral Linux test instances under separate scoped compute and networking grants.",
      "modelVisible": false
    }
  ],
  "events": {
    "subscribes": [
      "com.csweet.calendar.reminder-due.v1",
      "com.csweet.work.personal-todo.available.v1",
      "com.csweet.communication.message.mentioned.v1",
      "com.csweet.agent.coordination.turn-requested.v1",
      "com.csweet.user.message.received.v1",
      "com.csweet.compute.changed.v1"
    ]
  },
  "configuration": [
    {
      "key": "llmProviderId",
      "type": "provider",
      "label": "LLM provider",
      "required": true,
      "secret": false
    },
    {
      "key": "llmModel",
      "type": "model",
      "label": "Model",
      "required": true,
      "secret": false
    },
    {
      "key": "customInstructions",
      "type": "textarea",
      "label": "Custom instructions",
      "required": false,
      "secret": false
    },
    {
      "key": "maxContextWindowTokens",
      "type": "number",
      "label": "Maximum context-window tokens",
      "required": true,
      "secret": false,
      "defaultValue": 128000
    },
    {
      "key": "maxOutputTokens",
      "type": "number",
      "label": "Maximum output tokens",
      "required": true,
      "secret": false,
      "defaultValue": 16000
    },
    {
      "key": "computeWorkstreamId",
      "type": "text",
      "label": "Test-instance workstream",
      "required": false,
      "secret": false
    },
    {
      "key": "computeTemplateId",
      "type": "text",
      "label": "Linux test template",
      "required": false,
      "secret": false
    }
  ],
  "credentials": [],
  "webAccess": {
    "mode": "Allowlist",
    "rules": [
      {
        "scheme": "https",
        "host": "api.nuget.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Restore approved public NuGet packages"
      },
      {
        "scheme": "https",
        "host": "registry.npmjs.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Restore approved public npm packages"
      },
      {
        "scheme": "https",
        "host": "pypi.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Resolve approved public Python packages"
      },
      {
        "scheme": "https",
        "host": "files.pythonhosted.org",
        "port": 443,
        "pathPrefix": "/",
        "methods": [
          "GET"
        ],
        "protocol": "http",
        "purpose": "Download approved public Python packages"
      }
    ],
    "purpose": "Restore dependencies through the C-Sweet egress gateway; repository hosts come from installation grants"
  },
  "ui": [
    {
      "kind": "form",
      "id": "software-developer-settings",
      "title": "Software Developer settings",
      "capability": "agent.configuration.update.v1"
    }
  ],
  "catalog": {
    "imageUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.SoftwareDeveloper/main/assets/branding/portrait-v1.jpg",
    "companyLogoUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.SoftwareDeveloper/main/assets/branding/csweet-icon.svg",
    "accentColor": "#356286",
    "summary": "Implements production software from approved requirements while keeping changes reviewable, tested, and aligned with the product plan.",
    "category": "Engineering",
    "role": {
      "key": "software-developer",
      "name": "Software Developer"
    },
    "license": {
      "spdxId": "LicenseRef-Proprietary"
    },
    "iconUrls": [],
    "roleAliases": [
      "Software Developer",
      "Software Engineer",
      "Application Developer"
    ],
    "keywords": [
      "engineering",
      "implementation",
      "software delivery",
      "GitHub"
    ],
    "documentationUrl": "README.md"
  }
}
